# Environment Variables Configuration Example

NODE_ENV=development
PORT=5000

CLIENT_URL=http://localhost:5173

# Supabase Credentials (Optional in MOCK Mode)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# External Services Keys (Optional in MOCK Mode)
AI_PROVIDER_API_KEY=
WEATHER_API_KEY=

# Development Flags
USE_MOCK_DATA=true
