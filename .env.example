# BharatFarm Environment Configuration
# Copy this file to .env and fill in the values.

# ── Server ──────────────────────────────────────
PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Set to "true" to run entirely with in-memory mock data (no external APIs)
USE_MOCK_DATA=false

# ── Supabase (PostgreSQL Database) ──────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
# Server-only privileged key (bypasses RLS). NEVER expose to client.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── AI Providers ────────────────────────────────
# OpenRouter — used by KrishiBot, Scanner, Schemes, Weather advisory
OPENROUTER_API_KEY=your-openrouter-api-key

# Google Gemini — used by Roadmap module directly
GEMINI_API_KEY=your-gemini-api-key

# ── External APIs ──────────────────────────────
# BigDataCloud reverse geocoding (optional)
WEATHER_API_KEY=your-weather-api-key

# ── PWA Web Push (VAPID) ────────────────────────
# Generate VAPID keys by running:
#   npx web-push generate-vapid-keys
# Or from Node.js: require('web-push').generateVAPIDKeys()
#
# VAPID_PUBLIC_KEY is SAFE to expose to the frontend (set VITE_VAPID_PUBLIC_KEY in client/.env or here).
# VAPID_PRIVATE_KEY must NEVER be sent to the frontend.
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:bharatfarm@example.com

# ── Client PWA (exposed to Vite frontend) ───────
# This MUST match VAPID_PUBLIC_KEY above (only the public key).
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key
